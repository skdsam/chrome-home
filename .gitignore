# ============================================================
# Chrome Home — .gitignore
# ============================================================
# This is a PUBLIC repo. Nothing containing personal data,
# API keys, tokens, or account details should ever be committed.
# ============================================================

# --- User settings & local overrides ---
# If you create a local config file to override defaults,
# name it with .local or put it in config/ — it won't be committed.
*.local.js
*.local.json
config.local.*
settings.local.*
user.local.*
config/

# --- Environment & secrets ---
.env
.env.*
!.env.example
*.secret
secrets.*
credentials.*
api-keys.*

# --- Spotify / OAuth tokens ---
# NOTE: Spotify tokens are stored in chrome.storage.local (the browser),
# NOT in any file. These patterns are extra safety nets.
spotify-token.*
spotify-credentials.*
.spotify-credentials.*
.spotify-credentials.json
spotify-credentials.local.json
spotify-config.*
.spotify-config.*
.spotify-config.json
spotify-config.local.*
oauth-token.*
*.token.json

# --- Any file a user might accidentally save API keys into ---
keys.*
private.*
*.private.*
*.key
!*.pubkey

# --- OS & editor junk ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/settings.json

# --- Node / build artifacts ---
node_modules/
dist/
build/
.cache/
*.log
npm-debug.log*
pnpm-debug.log*

# --- Test infrastructure ---
.chrome-test-profile/
tests/
test/
*.test.js
*.spec.js
coverage/
.nyc_output/

# --- Generated local visual-test captures ---
screenshots/upgrade-preview.png

# Keep Spotify regression coverage reviewable.
!tests/
tests/*
!tests/spotify.test.js
!tests/spotify-server.test.js
